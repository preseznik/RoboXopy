<Project>
  <!--
    Single source of truth for the RoboXopy version (Semantic Versioning 2.0).
    tools\publish.ps1 updates this file: -Bump major|minor|patch changes VersionPrefix,
    and every published build increments BuildNumber (never reset, so it stays unique).
  -->
  <PropertyGroup>
    <VersionPrefix>1.2.12</VersionPrefix>
    <BuildNumber>17</BuildNumber>
  </PropertyGroup>
</Project>
