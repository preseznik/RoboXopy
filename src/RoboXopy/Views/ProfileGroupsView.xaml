<UserControl x:Class="RoboXopy.Views.ProfileGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RoboXopy.Controls"
             xmlns:vm="clr-namespace:RoboXopy.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,24,32,40" MaxWidth="1000">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Profile groups" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Preview or run grouped profiles one at a time. Every profile keeps its normal safety checks."
                               Style="{StaticResource SecondaryTextStyle}" Margin="2,4,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <c:InfoBar Severity="Informational" Title="Create a group from a profile"
                       Message="Set a profile's optional Group field on the General tab. Groups are case-insensitive and profiles run sequentially, never concurrently."
                       Margin="0,20,0,0" />

            <Border Style="{StaticResource CardStyle}" Padding="24,28" Visibility="{Binding HasGroups, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="No profile groups yet." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
            </Border>
            <ItemsControl ItemsSource="{Binding Groups}" Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileGroupItem}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                                    <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Button Content="Preview group" Command="{Binding PreviewCommand}" />
                                    <Button Content="Run group" Margin="8,0,0,0" Command="{Binding RunCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
