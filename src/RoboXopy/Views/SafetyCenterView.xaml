<UserControl x:Class="RoboXopy.Views.SafetyCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RoboXopy.Controls"
             xmlns:vm="clr-namespace:RoboXopy.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,24,32,40" MaxWidth="1000">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Safety Center" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Review the historical sources that protect profiles from accidental overwrite or deletion."
                               Style="{StaticResource SecondaryTextStyle}" Margin="2,4,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <c:InfoBar Severity="Informational" Title="Recorded sources are retained"
                       Message="RoboXopy keeps every folder used as a source, even after its profile changes or is deleted. This history prevents a former source from silently becoming a destination."
                       Margin="0,20,0,0" />

            <TextBlock Text="Historical sources" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource SecondaryTextStyle}" Margin="2,0,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="24,28" Visibility="{Binding HasSources, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="No source folders have been recorded yet." HorizontalAlignment="Center"
                           Style="{StaticResource SecondaryTextStyle}" />
            </Border>
            <ItemsControl ItemsSource="{Binding Sources}" Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RecordedSourceItem}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding UsageText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Risky destinations" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="{Binding AcknowledgementSummary}" Style="{StaticResource SecondaryTextStyle}" Margin="2,0,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="24,28" Visibility="{Binding HasRiskyDestinations, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="No profile destinations overlap a recorded source." HorizontalAlignment="Center"
                           Style="{StaticResource SecondaryTextStyle}" />
            </Border>
            <ItemsControl ItemsSource="{Binding RiskyDestinations}" Visibility="{Binding HasRiskyDestinations, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RiskyDestinationItem}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Profile.DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding StateText}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Destination}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Button Content="Open profile"
                                            Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Profile}" />
                                    <Button Content="Revoke acknowledgement" Margin="8,0,0,0"
                                            Visibility="{Binding IsAcknowledged, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.RevokeAcknowledgementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
