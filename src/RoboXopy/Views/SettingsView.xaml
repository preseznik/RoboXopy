<UserControl x:Class="RoboXopy.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RoboXopy.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,24,32,40" MaxWidth="1000">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="2,0,0,4" />

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
            <c:SettingsCard Icon="&#xE790;" Header="App theme" Description="Follow Windows, or pick light or dark.">
                <Border Style="{StaticResource SegmentedContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedItemStyle}" Content="System" GroupName="Theme"
                                     IsChecked="{Binding Model.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=System}" />
                        <RadioButton Style="{StaticResource SegmentedItemStyle}" Content="Light" GroupName="Theme"
                                     IsChecked="{Binding Model.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Light}" />
                        <RadioButton Style="{StaticResource SegmentedItemStyle}" Content="Dark" GroupName="Theme"
                                     IsChecked="{Binding Model.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Dark}" />
                    </StackPanel>
                </Border>
            </c:SettingsCard>

            <!-- Startup & tray -->
            <TextBlock Text="Startup and background" Style="{StaticResource SectionHeaderStyle}" />
            <c:SettingsCard Icon="&#xE7E8;" Header="Start with Windows"
                            Description="Sign in and RoboXopy starts in the background so in-app schedules keep running.">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Model.StartWithWindows}"
                          AutomationProperties.Name="Start with Windows" />
            </c:SettingsCard>
            <c:SettingsCard Icon="&#xE921;" Header="Start minimized to the notification area"
                            Description="When starting with Windows, don't open the main window."
                            IsEnabled="{Binding Model.StartWithWindows}">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Model.StartMinimized}"
                          AutomationProperties.Name="Start minimized" />
            </c:SettingsCard>
            <c:SettingsCard Icon="&#xE8BB;" Header="Keep running when the window is closed"
                            Description="Closing the window hides RoboXopy in the notification area. Use Exit from the tray menu to quit.">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Model.CloseToTray}"
                          AutomationProperties.Name="Keep running when closed" />
            </c:SettingsCard>

            <!-- Notifications -->
            <TextBlock Text="Notifications" Style="{StaticResource SectionHeaderStyle}" />
            <c:SettingsCard Icon="&#xEA8F;" Header="Show notifications" Description="Show a notification when a sync finishes.">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Model.ShowNotifications}"
                          AutomationProperties.Name="Show notifications" />
            </c:SettingsCard>
            <c:SettingsCard Icon="&#xE7BA;" Header="Only notify about problems"
                            Description="Skip notifications for successful runs; still notify on warnings, failures and skipped runs."
                            IsEnabled="{Binding Model.ShowNotifications}">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Model.NotifyOnlyOnProblems}"
                          AutomationProperties.Name="Only notify about problems" />
            </c:SettingsCard>
            <c:SettingsCard Icon="&#xE823;" Header="Notify when a sync becomes stale"
                            Description="Send one notification when a profile becomes stale or overdue. Disabled by default."
                            IsEnabled="{Binding Model.ShowNotifications}">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Model.NotifyOnStaleSync}"
                          AutomationProperties.Name="Notify when sync becomes stale" />
            </c:SettingsCard>
            <c:SettingsCard Icon="&#xE890;" Header="Notify when a scheduled preview finds changes"
                            Description="Send one notification for each scheduled preview that finds pending copies, removals, mismatches, or failures. Disabled by default."
                            IsEnabled="{Binding Model.ShowNotifications}">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Model.NotifyOnScheduledPreviewChanges}"
                          AutomationProperties.Name="Notify when scheduled preview finds changes" />
            </c:SettingsCard>

            <!-- Scheduling -->
            <TextBlock Text="Scheduling" Style="{StaticResource SectionHeaderStyle}" />
            <c:SettingsCard Icon="&#xE769;" Header="Pause in-app schedules"
                            Description="Scheduled runs handled by RoboXopy won't start. Profiles that use Windows Task Scheduler aren't affected.">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Model.SchedulerPaused}"
                          AutomationProperties.Name="Pause in-app schedules" />
            </c:SettingsCard>
            <c:SettingsCard Icon="&#xE8C8;" Header="Simultaneous scheduled runs"
                            Description="By default, scheduled runs and previews queue one at a time. Turn this on to run up to two or three at once.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Model.SimultaneousScheduledRuns}"
                              AutomationProperties.Name="Simultaneous scheduled runs" />
                    <ComboBox ItemsSource="{Binding SimultaneousRunChoices}" SelectedItem="{Binding Model.MaxSimultaneousScheduledRuns}"
                              IsEnabled="{Binding Model.SimultaneousScheduledRuns}" MinWidth="92" Margin="12,0,0,0"
                              ItemStringFormat="{}{0} runs" AutomationProperties.Name="Maximum simultaneous scheduled runs" />
                </StackPanel>
            </c:SettingsCard>
            <c:SettingsCard Icon="&#xE787;" Header="Windows Task Scheduler"
                            Description="{Binding TaskFolder, StringFormat='Tasks are registered in the {0} folder for your account.'}">
                <Button Command="{Binding OpenTaskSchedulerCommand}" AutomationProperties.Name="Open Task Scheduler">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Open Task Scheduler" />
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8A7;" FontSize="12" Margin="8,1,0,0" />
                    </StackPanel>
                </Button>
            </c:SettingsCard>

            <!-- Robocopy & logs -->
            <TextBlock Text="Robocopy and logs" Style="{StaticResource SectionHeaderStyle}" />
            <c:SettingsCard Icon="&#xE756;" Header="robocopy.exe" IsContentBelow="True"
                            Description="RoboXopy uses the robocopy that ships with Windows unless you pick a different one.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding RobocopyResolvedPath}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding RobocopyResolvedPath}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding RobocopyFound, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE7BA;" FontSize="12" Margin="0,0,6,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="File not found — syncs can't run until this points to robocopy.exe." FontSize="12"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Browse…" Margin="12,0,0,0" Command="{Binding BrowseRobocopyCommand}" />
                    <Button Grid.Column="2" Content="Use default" Margin="8,0,0,0" Command="{Binding ResetRobocopyPathCommand}"
                            Visibility="{Binding Model.RobocopyPath, Converter={StaticResource NullToVisibility}}" />
                </Grid>
            </c:SettingsCard>
            <c:SettingsCard Icon="&#xE81C;" Header="Run history to keep"
                            Description="Older runs and their log files are deleted automatically, per profile.">
                <ComboBox ItemsSource="{Binding RetentionChoices}" SelectedItem="{Binding Model.LogRetentionCount}" MinWidth="120"
                          ItemStringFormat="{}{0} runs" AutomationProperties.Name="Run history to keep" />
            </c:SettingsCard>
            <c:SettingsCard Icon="&#xE8B7;" Header="Data folder" Description="{Binding DataFolder}">
                <Button Command="{Binding OpenDataFolderCommand}" AutomationProperties.Name="Open data folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Open folder" />
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8A7;" FontSize="12" Margin="8,1,0,0" />
                    </StackPanel>
                </Button>
            </c:SettingsCard>

            <!-- Updates -->
            <StackPanel x:Name="UpdatesSection" DataContext="{Binding Updates}">
                <TextBlock Text="Updates" Style="{StaticResource SectionHeaderStyle}" />
                <c:SettingsCard Icon="&#xE895;" Header="{Binding Title}" Description="{Binding Description}"
                                AutomationProperties.Name="Update status">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="180" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}" VerticalAlignment="Center"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}"
                                     AutomationProperties.Name="Update progress" />
                        <Button Content="Cancel" Margin="12,0,0,0" Command="{Binding CancelDownloadCommand}"
                                Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenReleasePageCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="What's new"
                                Visibility="{Binding ShowReleaseNotes, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="What's new" />
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8A7;" FontSize="12" Margin="8,1,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Content="Check for updates" Command="{Binding CheckNowCommand}"
                                Visibility="{Binding ShowCheckButton, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding InstallButtonText}"
                                Command="{Binding InstallCommand}"
                                Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding OpenReleasePageCommand}"
                                AutomationProperties.Name="Open download page"
                                Visibility="{Binding ShowDownloadPageButton, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open download page" />
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8A7;" FontSize="12" Margin="8,1,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </c:SettingsCard>
                <c:SettingsCard Icon="&#xE823;" Header="Check for updates automatically"
                                Description="Checks GitHub once a day. Nothing is downloaded until you choose to install.">
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.Model.CheckForUpdates, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              AutomationProperties.Name="Check for updates automatically" />
                </c:SettingsCard>
            </StackPanel>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/Logo.png" Width="40" Height="40" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RoboXopy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"
                                   Text="A friendly front end for Windows robocopy. Tip: run a profile from a script with  RoboXopy.exe --run &quot;Profile name&quot;" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
