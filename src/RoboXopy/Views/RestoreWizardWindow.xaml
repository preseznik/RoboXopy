<Window x:Class="RoboXopy.Views.RestoreWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:RoboXopy.Controls"
        xmlns:vm="clr-namespace:RoboXopy.ViewModels"
        Title="Restore files" Width="700" MinHeight="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="WizardLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource LayerFillColorAltBrush}" Padding="28,24,28,20"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="Restore files from backup" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="22" />
                    <TextBlock Text="{Binding ProfileName, StringFormat='Restore a safe copy of “{0}”.'}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,20,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardStep}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="32" Height="1" Margin="10,0" VerticalAlignment="Center"
                                               Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                               Visibility="{Binding IsFirst, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <Grid Width="22" Height="22">
                                        <Ellipse x:Name="Circle" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1" />
                                        <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Margin="0,0,0,1"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource IconTextStyle}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Grid>
                                    <TextBlock x:Name="StepTitle" Text="{Binding Title}" Margin="7,0,0,1" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="28,24">
                <StackPanel Visibility="{Binding IsBackupStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Choose the backup to restore from" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                    <TextBlock Text="This starts with the destination of the selected profile. You can select another backup folder if needed."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,20" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BackupSource, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBoxStyle}"
                                 c:Placeholder.Text="Backup folder" AutomationProperties.Name="Restore backup source" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseBackupSourceCommand}" Content="Browse…" />
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{Binding IsTargetStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Choose where to restore the files" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                    <TextBlock Text="The original source is selected by default. Choose a separate folder to restore elsewhere."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,20" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RestoreDestination, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBoxStyle}"
                                 c:Placeholder.Text="Restore target folder" AutomationProperties.Name="Restore destination" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseRestoreDestinationCommand}" Content="Browse…" />
                    </Grid>
                    <c:InfoBar Severity="Warning" Title="Restore uses safe copy"
                               Message="Restore copies files from the backup without deleting target-only files. Existing target files may be overwritten when the backup version is newer."
                               Margin="0,20,0,0" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Preview the restoration" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                    <TextBlock Text="RoboXopy must complete a preview before restoration can continue. No files are changed by the preview."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,18" />
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="From" Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding BackupSource}" FontFamily="{StaticResource MonoFont}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="To" Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RestoreDestination}" FontFamily="{StaticResource MonoFont}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="14,12"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Preview result" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PreviewResultText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <c:InfoBar Severity="Error" Title="Preview needs attention"
                               Message="Fix the preview failure before restoring files."
                               Margin="0,16,0,0">
                        <c:InfoBar.Style>
                            <Style TargetType="c:InfoBar" BasedOn="{StaticResource {x:Type c:InfoBar}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasPreview}" Value="True" />
                                            <Condition Binding="{Binding PreviewSucceeded}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </c:InfoBar.Style>
                    </c:InfoBar>
                </StackPanel>

                <StackPanel Visibility="{Binding IsRestoreStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Confirm restoration" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                    <TextBlock Text="This copies the previewed backup files into the target folder. Target-only files are kept, but files can be overwritten."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,18" />
                    <StackPanel Visibility="{Binding HasRestored, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Type CONFIRM to restore files." />
                        <TextBox Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                 AutomationProperties.Name="Restore confirmation text" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="14,12"
                            Visibility="{Binding HasRestored, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Restoration result" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RestoreResultText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,16,28,20">
                <Grid>
                    <Button Content="Back" MinWidth="96" HorizontalAlignment="Left" Command="{Binding BackCommand}"
                            Visibility="{Binding IsFirstStep, Converter={StaticResource InverseBoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" MinWidth="96" Command="{Binding CancelCommand}"
                                IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBool}}"
                                Visibility="{Binding HasRestored, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Content="{Binding PrimaryText}" Style="{StaticResource AccentButtonStyle}" MinWidth="128" Margin="8,0,0,0"
                                Command="{Binding PrimaryCommand}" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
