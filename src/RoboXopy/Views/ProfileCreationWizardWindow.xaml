<Window x:Class="RoboXopy.Views.ProfileCreationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:RoboXopy.Controls"
        xmlns:vm="clr-namespace:RoboXopy.ViewModels"
        Title="Create a profile" Width="690" MinHeight="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="WizardLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource LayerFillColorAltBrush}" Padding="28,24,28,20"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="Create a sync profile" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="22" />
                    <TextBlock Text="A quick setup for your source, destination, and sync behavior."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,20,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardStep}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="32" Height="1" Margin="10,0" VerticalAlignment="Center"
                                               Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                               Visibility="{Binding IsFirst, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <Grid Width="22" Height="22">
                                        <Ellipse x:Name="Circle" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1" />
                                        <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Margin="0,0,0,1"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource IconTextStyle}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Grid>
                                    <TextBlock x:Name="StepTitle" Text="{Binding Title}" Margin="7,0,0,1" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="28,24">
                <StackPanel Visibility="{Binding IsSourceStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Where should RoboXopy copy from?" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                    <TextBlock Text="Choose the folder containing the files you want to protect or keep in sync."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,20" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBoxStyle}"
                                 c:Placeholder.Text="Source folder" AutomationProperties.Name="Source folder" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseSourceCommand}" Content="Browse…" />
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{Binding IsDestinationStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Where should RoboXopy copy to?" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                    <TextBlock Text="Choose a separate folder, drive, network share, or backup disk."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,20" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBoxStyle}"
                                 c:Placeholder.Text="Destination folder" AutomationProperties.Name="Destination folder" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseDestinationCommand}" Content="Browse…" />
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{Binding IsSyncTypeStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="How should the folders stay in sync?" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                    <TextBlock Text="You can change all of these settings later in the profile editor."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,18" />
                    <RadioButton Style="{StaticResource ChoiceCardStyle}" IsChecked="{Binding CopySelected, Mode=OneWay}" Command="{Binding SelectCopyCommand}"
                                 GroupName="SyncType" AutomationProperties.Name="Copy safely">
                        <StackPanel>
                            <TextBlock Text="Copy safely (recommended)" FontWeight="SemiBold" />
                            <TextBlock Text="Copy new and changed files. Keep files that exist only in the destination."
                                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChoiceCardStyle}" Margin="0,10,0,0" IsChecked="{Binding MirrorSelected, Mode=OneWay}"
                                 Command="{Binding SelectMirrorCommand}" GroupName="SyncType" AutomationProperties.Name="Mirror destination">
                        <StackPanel>
                            <TextBlock Text="Mirror destination" FontWeight="SemiBold" />
                            <TextBlock Text="Make the destination match the source exactly. Destination-only files and folders are deleted."
                                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Review your profile" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                    <TextBlock Text="RoboXopy starts with conservative copy settings. You can refine them any time."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,18" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" Style="{StaticResource WizardLabelStyle}" />
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Profile name" />
                        <TextBlock Grid.Row="2" Text="Source" Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Source}" FontFamily="{StaticResource MonoFont}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Text="Destination" Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Destination}" FontFamily="{StaticResource MonoFont}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="6" Text="Behavior" Style="{StaticResource WizardLabelStyle}" />
                        <StackPanel Grid.Row="6" Grid.Column="1">
                            <TextBlock Text="{Binding SyncTypeDescription}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SyncTypeWarning}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Suggested settings" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SuggestedSettings}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,16,28,20">
                <Grid>
                    <StackPanel HorizontalAlignment="Left">
                        <CheckBox Content="Don't show this wizard automatically when RoboXopy starts"
                                  IsChecked="{Binding SkipOnStartup}" />
                        <Button Content="Back" Margin="0,12,0,0" MinWidth="96" HorizontalAlignment="Left"
                                Command="{Binding BackCommand}" Visibility="{Binding IsFirstStep, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="Cancel" MinWidth="96" Command="{Binding CancelCommand}" IsCancel="True" />
                        <Button Content="{Binding PrimaryText}" Style="{StaticResource AccentButtonStyle}" MinWidth="120" Margin="8,0,0,0"
                                Command="{Binding NextCommand}" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
